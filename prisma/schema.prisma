generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-1.0.x", "linux-arm64-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                          @id @default(uuid())
  phone                         String?                         @unique
  email                         String?                         @unique
  password                      String?
  firstName                     String?                         @map("first_name")
  lastName                      String?                         @map("last_name")
  postalCode                    String?                         @map("postal_code")
  stripeCustomerId              String?                         @unique @map("stripe_customer_id")
  stripeDefaultPaymentMethodId  String?                         @map("stripe_default_payment_method_id")
  cardLastFourDigits            String?                         @map("card_last_four_digits")
  imageUrl                      String?                         @map("image_url")
  imageKey                      String?                         @map("image_key")
  role                          Role                            @default(USER)
  createdAt                     DateTime                        @default(now()) @map("created_at")
  updatedAt                     DateTime                        @updatedAt @map("updated_at")
  notificationToken             String?                         @map("notification_token")
  onboardingStage               Int                             @default(0) @map("onboarding_stage")
  isVerified                    Boolean                         @default(false) @map("is_verified")
  refCode                       String?                         @unique @map("ref_code")
  referrerId                    String?                         @map("referrer_id")
  metadata                      Json?
  firstPaymentDate              DateTime?                       @map("first_payment_date")
  userCode                      String?                         @unique @map("user_code")
  basketsC                      BasketC[]
  baskets                       Basket[]
  billingAddress                BillingAddress?
  bonuses                       Bonus[]
  hosts                         BuyingTeam[]
  chats                         Chat[]
  claims                        Claim[]
  collection                    Collection[]
  coupons                       Coupon[]
  employee                      Employee[]
  followings                    Follower[]                      @relation("followings")
  myFollowers                   Follower[]                      @relation("myFollowers")
  invites                       Invite[]
  likes                         Like[]
  notifications                 Notification[]
  confirmation                  OrderConfirmation[]
  PartitionedProductUsersRecord PartitionedProductUsersRecord[]
  partner                       Partner?
  paymentMethods                PaymentMethod[]
  payments                      Payment[]
  producer                      Producer?
  recentlyViewed                RecentlyViewed[]
  reviews                       Review[]
  searches                      Search[]
  shipping                      Shipping?
  subscription                  Subscription?
  teams                         TeamMember[]
  requests                      TeamRequest[]
  topUpBasket                   TopUpBasket[]
  wallet                        Wallet?

  @@index([id])
  @@map("users")
}

model PaymentMethod {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  stripeCustomerId   String   @map("stripe_customer_id")
  paymentMethodId    String   @map("payment_method_id")
  isDefault          Boolean  @default(true) @map("is_default")
  cardLastFourDigits String   @map("card_last_four_digits")
  fingerprint        String   @unique
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  active             Boolean  @default(true)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId, fingerprint])
  @@map("payment_methods")
}

model Producer {
  id              String                @id @default(uuid())
  userId          String                @unique
  isVerified      Boolean               @default(false) @map("is_verified")
  imageUrl        String?               @default("https://rabble-dev1.s3.us-east-2.amazonaws.com/suppliers/Frame+9.png") @map("image_url")
  imageKey        String?               @map("image_key")
  businessName    String                @unique @map("business_name")
  businessAddress String?               @map("business_address")
  accountsEmail   String?               @map("acounts_email")
  salesEmail      String?               @map("sales_email")
  website         String?
  description     String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  paymentTerm     Int?                  @default(30) @map("payment_term")
  vat             String?               @unique
  stripeConnectId String?               @unique @map("stripe_connect_id")
  minimumTreshold Decimal               @default(5000.00) @map("minimum_treshold") @db.Decimal(9, 2)
  buyingteams     BuyingTeam[]
  chats           Chat[]
  likes           Like[]
  categories      ProducerCategory[]
  deliveryDays    ProducerDeliveryDay[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  recentlyViewed  RecentlyViewed[]
  reviews         Review[]

  @@index([id, userId])
  @@map("producers")
}

model ProducerCategoryOption {
  id         String             @id @default(uuid())
  name       String             @unique
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  categories ProducerCategory[]

  @@index([id])
  @@map("producer_categories_options")
}

model ProducerCategory {
  id                       String                 @id @default(uuid())
  producerId               String                 @map("producer_id")
  producerCategoryOptionId String                 @map("producer_category_option_id")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  category                 ProducerCategoryOption @relation(fields: [producerCategoryOptionId], references: [id], onDelete: Cascade)
  producer                 Producer               @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([producerId, producerCategoryOptionId], name: "producer_unique_category_option")
  @@index([id, producerId, producerCategoryOptionId])
  @@map("producer_categories")
}

model Partner {
  id              String       @id @default(uuid())
  userId          String       @unique @map("user_id")
  name            String       @unique
  postalCode      String       @map("postal_code")
  stripeConnectId String?      @unique @map("stripe_connect_id")
  city            String
  direction       String
  storeType       String       @map("store_type")
  shelfSpace      String       @map("shelf_type")
  dryStorageSpace String       @map("dry_storage_space")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  streetAddress   String       @map("street_address")
  buyingteams     BuyingTeam[]
  chats           Chat[]
  Employee        Employee[]
  openhour        OpenHours?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("partners")
}

model Employee {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  partnerId String   @map("partner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@index([id, userId, partnerId])
  @@map("employees")
}

model OpenHours {
  id              String            @id @default(uuid())
  partnerId       String            @unique @map("partner_id")
  type            PartnerOpenHour   @default(ALL_THE_TIME)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  CustomOpenHours CustomOpenHours[]
  partner         Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([id, partnerId])
  @@map("open_hours")
}

model CustomOpenHours {
  id         String     @id @default(uuid())
  openHourId String     @map("open_hour_id")
  day        DayOptions
  startTime  String     @map("start_time")
  endTime    String     @map("end_time")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  openHour   OpenHours  @relation(fields: [openHourId], references: [id], onDelete: Cascade)

  @@index([id, openHourId])
  @@map("custom-open_hours")
}

model Shipping {
  id         String   @id @default(uuid())
  userId     String   @unique
  buildingNo String?  @map("building_no")
  address    String
  city       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  country    String?
  address2   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("shippings")
}

model Product {
  id                        String                      @id @default(uuid())
  name                      String
  imageUrl                  String?                     @map("image_url")
  imageKey                  String?                     @map("image_key")
  description               String?
  producerId                String                      @map("producer_id")
  categoryId                String?                     @map("category_id")
  status                    ProductStatus               @default(IN_STOCK)
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  type                      ProductType                 @default(SINGLE)
  orderUnit                 String                      @default("Box") @map("order_unit")
  subUnit                   String                      @default("Carton") @map("sub_unit")
  measuresPerSubUnit        Int                         @default(1) @map("measures_per_subunit")
  quantityOfSubUnitPerOrder Int                         @default(1) @map("quantity_of_subunit_per_order")
  unitsOfMeasurePerSubUnit  String                      @default("Carton") @map("units_of_measure_per_subunit")
  stock                     Int?                        @default(0)
  alignmentStock            Int?                        @default(0) @map("alignment_stock")
  approvalStatus            ProductApprovalStatus       @default(PENDING) @map("approval_status")
  wholesalePrice            Decimal?                    @default(0) @map("wholesale_price") @db.Decimal(9, 2)
  price                     Decimal                     @default(0) @db.Decimal(9, 2)
  retailPrice               Decimal?                    @default(0) @map("retail_price") @db.Decimal(9, 2)
  vat                       Decimal?                    @default(0) @db.Decimal(9, 2)
  rabbleMarkUp              Decimal?                    @default(0) @map("rabble_mark_up") @db.Decimal(9, 2)
  rrp                       Decimal?                    @default(0) @db.Decimal(9, 2)
  tags                      String[]                    @default([])
  capsuleInfo               Json?                       @map("capsule_info")
  priceInfo                 Json?                       @map("price_info")
  formulationSummary        String[]                    @default([]) @map("formulation_summary")
  leadTime                  Int?                        @default(0) @map("lead_time")
  healthCategories          Json?                       @map("health_categories")
  productBenefits           Json?                       @map("product_benefits")
  gramsPerCount             Decimal?                    @default(5) @map("grams_per_count")
  poucheSize                Decimal?                    @default(90) @map("pouche_size")
  alignmentPoucheSize       Decimal?                    @default(30) @map("alignment_pouche_size")
  skuDrop                   String?                     @map("sku_drop")
  skuAlignment              String?                     @map("sku_alignment")
  BasketC                   BasketC[]
  basket                    Basket[]
  collectionItem            CollectionItems[]
  likes                     Like[]
  partionedProducts         PartitionedProductsBasket[]
  category                  ProductCategory?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  producer                  Producer                    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  recentlyViewed            RecentlyViewed[]
  reviews                   Review[]
  supplementTeamProducts    SupplementTeamProducts?
  topUpBasket               TopUpBasket[]

  @@unique([name, producerId], name: "name_unique_producer")
  @@index([id, producerId, categoryId])
  @@map("products")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([id])
  @@map("product_category")
}

model PartitionedProductsBasket {
  id                            String                          @id @default(uuid())
  teamId                        String                          @map("team_id")
  orderId                       String                          @map("order_id")
  productId                     String                          @map("product_id")
  threshold                     Int
  accumulator                   Int
  createdAt                     DateTime                        @default(now()) @map("created_at")
  updatedAt                     DateTime                        @updatedAt @map("updated_at")
  PartitionedProductUsersRecord PartitionedProductUsersRecord[]
  order                         Order                           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                       Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  team                          BuyingTeam                      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([id, teamId, orderId, productId])
  @@map("partitioned_products_basket")
}

model PartitionedProductUsersRecord {
  id                String                    @id @default(uuid())
  partionedBasketId String                    @map("partioned_basket_id")
  userId            String                    @map("user_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  quantity          Int                       @default(1)
  amount            Decimal                   @default(0) @db.Decimal(9, 2)
  partionedBasket   PartitionedProductsBasket @relation(fields: [partionedBasketId], references: [id], onDelete: Cascade)
  owner             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partionedBasketId, userId], name: "user_record")
  @@index([id, userId, partionedBasketId])
  @@map("partitioned_product_users_record")
}

model BuyingTeam {
  id                     String                      @id @default(uuid())
  name                   String                      @unique
  postalCode             String                      @map("postal_code")
  producerId             String                      @map("producer_id")
  hostId                 String                      @map("host_id")
  frequency              Int                         @default(104500)
  description            String?
  isPublic               Boolean                     @default(true) @map("is_public")
  imageUrl               String?                     @default("https://rabble-dev1.s3.us-east-2.amazonaws.com/teams/renaissance16.png") @map("image_url")
  imageKey               String?                     @map("image_key")
  nextDeliveryDate       DateTime?                   @map("next_delivery_date")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  deliveryDay            DayOptions?                 @map("delivery_day")
  partnerId              String?
  productLimit           Decimal?                    @map("product_limit")
  basket                 BasketC[]
  host                   User                        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  Partner                Partner?                    @relation(fields: [partnerId], references: [id])
  producer               Producer                    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  chats                  Chat[]
  invites                Invite[]
  likes                  Like[]
  notifications          Notification[]
  orders                 Order[]
  partionedProducts      PartitionedProductsBasket[]
  recentlyViewed         RecentlyViewed[]
  supplementTeamProducts SupplementTeamProducts?
  members                TeamMember[]
  requests               TeamRequest[]

  @@index([id, hostId, producerId])
  @@map("buying_teams")
}

model SupplementTeamProducts {
  id                      String               @id @default(uuid())
  teamId                  String               @unique @map("team_id")
  productId               String               @unique @map("product_id")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  orderTreashold          Int                  @default(10) @map("order_treashold")
  status                  SupplementTeamStatus @default(PREORDER) @map("status")
  foundingMembersDiscount Decimal              @default(10) @map("founding_members_discount") @db.Decimal(9, 2)
  earlyMembersDiscount    Decimal              @default(5) @map("early_members_discount") @db.Decimal(9, 2)
  product                 Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  team                    BuyingTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([id, teamId, productId])
  @@map("supplement_team_products")
}

model SupplementTags {
  id        String             @id @default(uuid())
  name      String             @unique
  type      SupplementTagTypes @default(CATEGORY) @map("type")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("supplement_tags")
}

model Review {
  id         String    @id @default(uuid())
  text       String
  reviewerId String    @map("reviewer_id")
  producerId String?   @map("producer_id")
  productId  String?   @map("product_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  producer   Producer? @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer   User      @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([id, reviewerId, producerId, productId])
  @@map("reviews")
}

model TeamMember {
  id                 String             @id @default(uuid())
  teamId             String             @map("team_id")
  userId             String             @map("user_id")
  status             TeamStatus
  role               MembershipStatus   @default(MEMBER)
  skipNextDelivery   Boolean            @default(false)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  team               BuyingTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "team_unique_user")
  @@index([id, teamId, userId, status])
  @@map("team_members")
}

model TeamRequest {
  id           String     @id @default(uuid())
  teamId       String     @map("team_id")
  userId       String     @map("user_id")
  introduction String
  status       TeamStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  team         BuyingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, teamId, userId, status])
  @@map("team_requests")
}

model Follower {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  followerId String   @map("follower_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  follower   User     @relation("followings", fields: [followerId], references: [id], onDelete: Cascade)
  user       User     @relation("myFollowers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, followerId], name: "user_unique_follower")
  @@index([id, userId])
  @@map("followers")
}

model Like {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  productId  String?     @map("product_id")
  producerId String?     @map("producer_id")
  teamId     String?     @map("team_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  producer   Producer?   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  team       BuyingTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "user_unique_product")
  @@unique([userId, producerId], name: "user_unique_producer")
  @@unique([userId, teamId], name: "user_unique_team")
  @@index([userId, productId, producerId, teamId])
  @@map("likes")
}

model Invite {
  id        String     @id @default(uuid())
  teamId    String     @map("team_id")
  status    TeamStatus @default(PENDING)
  phone     String
  token     String?
  userId    String     @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  team      BuyingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, teamId, status])
  @@map("invites")
}

model Order {
  id                 String                      @id @default(uuid())
  teamId             String                      @map("team_id")
  status             OrderStatus                 @default(PENDING)
  deadline           DateTime                    @default(now())
  lastNudge          DateTime?                   @map("last_nudge")
  deliveryDate       DateTime?                   @map("delivery_date")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  minimumTreshold    Decimal                     @default(0) @map("minimum_treshold") @db.Decimal(9, 2)
  accumulatedAmount  Decimal                     @default(0) @map("accumulated_amount") @db.Decimal(9, 2)
  confirmationStatus OrderConfirmationStatus     @default(PENDING) @map("confirmation_status")
  type               OrderType                   @default(RABBLE)
  firstDelivery      Boolean                     @default(false)
  basket             Basket[]
  bonuses            Bonus[]
  collection         Collection[]
  notifications      Notification[]
  orderConfirmation  OrderConfirmation?
  team               BuyingTeam                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  partionedProducts  PartitionedProductsBasket[]
  payments           Payment[]
  topUpBasket        TopUpBasket[]

  @@index([id, teamId, status])
  @@map("orders")
}

model OrderConfirmation {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  imageUrl    String   @map("confirmation_image_url")
  imageKey    String   @map("confirmation_image_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  note        String?
  products    Json
  confirmedBy String   @map("confirmed_by")
  confirmer   User     @relation(fields: [confirmedBy], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([id, orderId])
  @@map("order_confirmation")
}

model Collection {
  id               String                @id @default(uuid())
  orderId          String                @map("order_id")
  userId           String                @map("user_id")
  dateOfCollection DateTime              @map("date_of_collection")
  status           OrderCollectionStatus @default(PENDING)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  qrCode           String                @default("") @map("qr_code")
  items            CollectionItems[]
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId], name: "user_unique_collection")
  @@index([id, orderId, userId])
  @@map("collections")
}

model CollectionItems {
  id           String     @id @default(uuid())
  collectionId String     @map("collection_id")
  productId    String     @map("product_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  quantity     Decimal    @default(0) @db.Decimal(9, 2)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId], name: "collection_unique_product")
  @@index([id, collectionId])
  @@map("collection_items")
}

model Basket {
  id            String               @id @default(uuid())
  orderId       String               @map("order_id")
  userId        String               @map("user_id")
  productId     String               @map("product_id")
  quantity      Int
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  price         Decimal              @default(0) @db.Decimal(9, 2)
  paymentStatus ProductPaymentStatus @default(PENDING) @map("payment_status")
  capsulePerDay Decimal              @default(0) @map("capsule_per_day") @db.Decimal(9, 2)
  discount      Decimal              @default(0) @map("discount") @db.Decimal(9, 2)
  pricePerCount Decimal              @default(0) @map("price_per_count") @db.Decimal(9, 2)
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId, productId], name: "user_unique_product")
  @@index([id, orderId, userId])
  @@map("baskets")
}

model BasketC {
  id            String     @id @default(uuid())
  teamId        String     @map("team_id")
  userId        String     @map("user_id")
  productId     String     @map("product_id")
  quantity      Int
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  price         Decimal    @default(0) @db.Decimal(9, 2)
  capsulePerDay Decimal    @default(0) @map("capsule_per_day") @db.Decimal(9, 2)
  discount      Decimal    @default(0) @map("discount") @db.Decimal(9, 2)
  pricePerCount Decimal    @default(0) @map("price_per_count") @db.Decimal(9, 2)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  team          BuyingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, productId], name: "team_unique_product")
  @@index([id, userId, teamId])
  @@map("basket_c")
}

model TopUpBasket {
  id             String              @id @default(uuid())
  orderId        String              @map("order_id")
  userId         String              @map("user_id")
  productId      String              @map("product_id")
  quantity       Int
  price          Decimal             @default(0) @db.Decimal(9, 2)
  deliveryStatus TopUpDeliveryStatus @default(PENDING) @map("delivery_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  capsulePerDay  Decimal             @default(0) @map("capsule_per_day") @db.Decimal(9, 2)
  deliveryDate   DateTime?           @map("delivery_date")
  type           TopUpType           @default(ALIGNMENT) @map("type")
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, orderId, userId])
  @@map("top_up_baskets")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String?       @map("order_id")
  userId          String?       @map("user_id")
  paymentIntentId String?       @unique
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  amount          Decimal       @default(0) @db.Decimal(9, 2)
  discount        Decimal       @default(0) @db.Decimal(9, 2)
  coupons         String?       @map("coupons")
  expiryDate      DateTime?     @map("expiry_date")
  type            PaymentType   @default(OTHERS)
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, userId, status])
  @@map("payments")
}

model Notification {
  id         String           @id @default(uuid())
  orderId    String?          @map("order_id")
  userId     String?          @map("user_id")
  teamId     String?          @map("team_id")
  producerId String?          @map("producer_id")
  title      String?
  text       String
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  type       NotificationType @default(TEAM)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  team       BuyingTeam?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model RecentlyViewed {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  teamId     String?     @map("team_id")
  producerId String?     @map("producer_id")
  productId  String?     @map("product_id")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  producer   Producer?   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  team       BuyingTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recently_viewed")
}

model Search {
  id        String         @id @default(uuid())
  keyword   String
  userId    String         @map("user_id")
  category  SearchCategory
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("searches")
}

model SearchCount {
  id        String         @id @default(uuid())
  keyword   String
  category  SearchCategory
  count     Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([keyword, category])
  @@map("search_count")
}

model Chat {
  id         String     @id @default(uuid())
  teamId     String     @map("team_id")
  userId     String     @map("user_id")
  producerId String?    @map("producer_id")
  text       String
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  partnerId  String?
  Partner    Partner?   @relation(fields: [partnerId], references: [id])
  producer   Producer?  @relation(fields: [producerId], references: [id], onDelete: Cascade)
  team       BuyingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, teamId, producerId])
  @@map("chats")
}

model NWRO {
  id        String   @id @default(uuid())
  week      Int
  year      Int
  value     Decimal  @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([week, year], name: "nwro_unique")
  @@map("nwro")
}

model UniqueUsers {
  id        String   @id @default(uuid())
  week      Int
  year      Int
  value     Decimal  @default(0.0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([week, year], name: "unique_record")
  @@map("unique_users")
}

model PostalCodeRegion {
  id                     String                   @id @unique
  name                   String                   @unique
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  postalCodeArea         PostalCodeArea[]
  producerDeliveryRegion ProducerDeliveryRegion[]

  @@index([name])
  @@map("postalCodeRegions")
}

model PostalCodeArea {
  id                   String                 @id @default(uuid())
  code                 String                 @unique
  name                 String                 @unique
  regionId             String                 @map("region_id")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  region               PostalCodeRegion       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  producerDeliveryArea ProducerDeliveryArea[]

  @@index([name])
  @@map("postalCodeAreas")
}

model ProducerDeliveryDay {
  id         String                   @id @default(uuid())
  day        DayOptions
  cutOffDay  DayOptions               @map("cut_off_day")
  cutOffTime String                   @map("cut_off_time")
  producerId String                   @map("producer_id")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")
  producer   Producer                 @relation(fields: [producerId], references: [id], onDelete: Cascade)
  regions    ProducerDeliveryRegion[]

  @@unique([producerId, day])
  @@index([id, producerId, day])
  @@map("producer_delivery_days")
}

model ProducerDeliveryRegion {
  id            String                 @id @default(uuid())
  deliveryDayId String                 @map("delivery_day_id")
  regionId      String                 @map("region_id")
  minimumOrder  Decimal                @map("minimum_order")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  producerAreas ProducerDeliveryArea[]
  deliveryDay   ProducerDeliveryDay    @relation(fields: [deliveryDayId], references: [id], onDelete: Cascade)
  region        PostalCodeRegion       @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([deliveryDayId, regionId])
  @@index([id, deliveryDayId, regionId])
  @@map("producer_delivery_regions")
}

model ProducerDeliveryArea {
  id               String                 @id @default(uuid())
  deliveryRegionId String                 @map("delivery_region_id")
  areaId           String                 @map("region_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deliveryRegion   ProducerDeliveryRegion @relation(fields: [deliveryRegionId], references: [id], onDelete: Cascade)
  area             PostalCodeArea         @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([id, deliveryRegionId, areaId])
  @@map("producer_delivery_areas")
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  balance          Decimal
  claimed          Decimal
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  availableCredits Decimal  @default(0) @map("available_credits")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("wallets")
}

model Claim {
  id        String   @id @default(uuid())
  amount    Decimal
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  rewardId  String   @default("") @map("reward_id")
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("claims")
}

model Coupon {
  id        String   @id @default(uuid())
  amount    Decimal  @default(0)
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("coupons")
}

model Reward {
  id        String   @id @default(uuid())
  amount    Int
  rate      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  claims    Claim[]

  @@index([id])
  @@map("rewards")
}

model Bonus {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  amount     Decimal
  type       BonusType
  referralId String?   @map("referral_id")
  orderId    String?   @map("order_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  category   String?   @default("credit")
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("bonuses")
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String             @unique @map("user_id")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  status     SubscriptionStatus @default(ACTIVE)
  expiryDate DateTime?          @map("expiry_date")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("subscriptions")
}

model Referral {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  referrerId  String?      @map("referrer_id")
  type        ReferralType @default(INTERNAL)
  affiliateId String?      @map("affiliate_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([id, userId])
  @@map("referrals")
}

model Affiliate {
  id           String              @id @default(uuid())
  code         String              @unique
  description  String?
  rewardType   AffiliateRewardType @default(CREDIT)
  rewardAmount Decimal             @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([id])
  @@map("affiliates")
}

model BillingAddress {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  postCode     String   @map("post_code")
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  country      String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
  @@map("billing_addresses")
}

